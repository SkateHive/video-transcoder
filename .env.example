# Pinata JWT (create in Pinata dashboard -> API Keys)
PINATA_JWT=eyJhbGciOi...

# Optional: override gateway base URL
# PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Optional tuning
# MAX_UPLOAD_MB=512
# X264_PRESET=veryfast
# X264_CRF=22
# AAC_BITRATE=128k
# PORT=8080

# F3: POST /thumbnail — shared secret, must match skatehive-api's
# THUMBNAIL_SHARED_SECRET. Required; the route 401s on every request until set.
THUMBNAIL_SHARED_SECRET=

# Optional: kill timeout (ms) for the gateway-fetch + ffmpeg step in /thumbnail
# THUMBNAIL_FETCH_TIMEOUT_MS=60000

# Spotmap images: POST /image-thumbnail — reuses THUMBNAIL_SHARED_SECRET above.
# Optional: timeout (ms) for each of the download and ffmpeg steps.
# IMAGE_THUMBNAIL_TIMEOUT_MS=60000
# Optional: max download size in bytes.
# IMAGE_THUMBNAIL_MAX_BYTES=26214400
# Optional: SSRF allow-list (comma-separated hostnames) for the `url` field —
# must match skatehive-api's IMAGE_THUMBNAIL_ALLOWED_HOSTS. Anything not on
# this list 400s before any network call.
# IMAGE_THUMBNAIL_ALLOWED_HOSTS=images.hive.blog,files.peakd.com,mymaps.usercontent.google.com,lh3.googleusercontent.com,ipfs.skatehive.app

# CORS: all origins allowed by default
NODE_ENV=development
